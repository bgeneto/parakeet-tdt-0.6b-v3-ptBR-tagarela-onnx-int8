# Copy to `.env`. Secrets and per-host settings only.
# Paths inside the container (MODEL_DIR, UPLOAD_DIR), MODEL_ARCH, HOST,
# thread counts, chunking, and CUDA/ORT flags are fixed in compose.yaml / the
# image. Extra keys still work via env_file if you add them on purpose.

# Required before exposing the API. Empty = public transcription endpoints.
API_KEY=

# Hugging Face token — used only when ./models/parakeet has no encoder yet.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Which ONNX checkpoint to download/load. Restart after changing; no image rebuild.
#   pt-BR          TAGARELA FP32 — Brazilian Portuguese, GPU (alefiury/...-TAGARELA-onnx)
#   pt-BR-INT8     TAGARELA INT8 — Brazilian Portuguese, CPU / smaller files (calneymgp/...-int8)
#   multilanguage  NVIDIA Parakeet TDT 0.6B v3 — 25 European languages
#                  (ONNX export of nvidia/parakeet-tdt-0.6b-v3 via istupakov/...-onnx)
MODEL_VARIANT=multilanguage

# Host directory with ONNX weights (bind-mounted at /opt/models/parakeet).
MODEL_HOST_DIR=./models/parakeet

# nvidia-smi index. One GPU. FP32 often needs 8 GB arena; raise if CUDA OOM.
GPU_ID=0
GPU_MEM_LIMIT_GB=8

# 0 = keep the model in VRAM. 60 = unload after 1 min idle (share the GPU).
SLEEP_IDLE_SECONDS=60

PORT=8084
