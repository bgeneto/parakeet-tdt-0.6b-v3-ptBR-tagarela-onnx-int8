# Parakeet TDT 0.6B v3 pt-BR (ONNX INT8) - Environment Variables

# Model Configuration
MODEL_DIR=/opt/models/parakeet
MODEL_ARCH=nemo-parakeet-tdt-0.6b-v3
QUANTIZATION=int8
LANGUAGE=pt-BR

# GPU & Hardware Settings
GPU_ID=0
GPU_MEM_LIMIT_GB=4
CUDA_MODULE_LOADING=LAZY

# Audio VAD & Chunking
MAX_CHUNK_S=25
MIN_CHUNK_S=0.25

# Concurrency & Threads
MAX_CONCURRENT=1
ORT_INTRA_THREADS=4
ORT_INTER_THREADS=2
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Server & Logging
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
UPLOAD_DIR=/tmp/stt
