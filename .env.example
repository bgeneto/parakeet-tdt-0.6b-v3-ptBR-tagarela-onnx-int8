# Parakeet TDT 0.6B v3 pt-BR (ONNX INT8) - Environment Variables

# Model Configuration
MODEL_DIR=/opt/models/parakeet
MODEL_ARCH=nemo-conformer-tdt
QUANTIZATION=int8
LANGUAGE=pt-BR
MODEL_ID=parakeet-tdt-0.6b-v3-ptBR

# GPU & Hardware Settings
GPU_ID=0
GPU_MEM_LIMIT_GB=4
CUDA_MODULE_LOADING=LAZY
CUDNN_CONV_ALGO_SEARCH=HEURISTIC
CUDNN_CONV_MAX_WORKSPACE=0

# Audio chunking (window = Whisper-like long context; do not use vad on podcasts)
CHUNKING=window
MAX_CHUNK_S=20
CHUNK_OVERLAP_S=1.0
MIN_CHUNK_S=0.5
MAX_UPLOAD_MB=512

# Concurrency & Threads
MAX_CONCURRENT=1
ORT_INTRA_THREADS=4
ORT_INTER_THREADS=2
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Idle VRAM release (0 = never unload; like llama-server --sleep-idle-seconds)
SLEEP_IDLE_SECONDS=60
LOAD_AT_STARTUP=1
CUDA_DEVICE_RESET=1

# Server & Logging
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
UPLOAD_DIR=/tmp/stt
# API_KEY=
CORS_ENABLE=1
CORS_ORIGINS=*
