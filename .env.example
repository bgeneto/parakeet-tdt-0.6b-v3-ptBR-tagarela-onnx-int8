# Parakeet TDT 0.6B v3 pt-BR (ONNX) - Environment Variables
# GPU: USE_QUANTIZATION=false (FP32). CPU/size: USE_QUANTIZATION=true (dynamic INT8).
# Copy to `.env` and edit. Docker Compose interpolates this file and injects it
# into the container. Leave a value empty only when the default in app.py / image is fine.

# --- API authentication (transcription endpoints) ---
# Empty = /v1/audio/transcriptions and /transcribe are public (local/dev only).
# Set a long random secret before exposing the API. Clients must send either:
#   Authorization: Bearer <API_KEY>
#   X-API-Key: <API_KEY>
API_KEY=

# --- Hugging Face Hub (image build only) ---
# Read token from https://huggingface.co/settings/tokens
# Compose passes this as a build secret while downloading ONNX weights.
# Avoids anonymous Hub rate limits. Not needed at runtime (model is baked in).
# Leave empty only if you accept unauthenticated Hub requests.
HF_TOKEN=

# --- Model Configuration ---
# false = FP32 for GPU (~2.5 GB). MatMul stays on CUDA EP (cuBLAS).
#         alefiury/parakeet-tdt-0.6b-v3-ptBR-TAGARELA-onnx
#         Use this on NVIDIA GPUs. Several times faster than INT8 on this stack.
# true  = dynamic INT8 (~0.9 GB), designed for CPU (quantize_dynamic, MatMul-only).
#         calneymgp/parakeet-tdt-0.6b-v3-ptBR-TAGARELA-onnx-int8
#         Smaller disk/VRAM. On CUDA EP, MatMulInteger often falls back to CPU
#         and is much slower than FP32 — not Tensor-Core INT8.
# After changing this, rebuild so the image fetches the matching repo:
#   docker compose up -d --build
USE_QUANTIZATION=false
MODEL_DIR=/opt/models/parakeet
MODEL_ARCH=nemo-conformer-tdt
LANGUAGE=pt-BR
# API display name in /v1/models and verbose_json. Empty = derived from USE_QUANTIZATION.
MODEL_ID=parakeet-tdt-0.6b-v3

# --- GPU & Hardware Settings ---
# Host GPU index from `nvidia-smi` (0, 1, …). Compose pins that device; inside
# the container it is always CUDA device 0. One ID only — Compose cannot turn
# a comma list (0,1) into device_ids: ["0","1"].
# USE_QUANTIZATION=false (FP32) may need GPU_MEM_LIMIT_GB=8 if you hit CUDA OOM.
GPU_ID=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility
GPU_MEM_LIMIT_GB=6
CUDA_MODULE_LOADING=LAZY
CUDNN_CONV_ALGO_SEARCH=HEURISTIC
CUDNN_CONV_MAX_WORKSPACE=1
ORT_ARENA_EXTEND=kNextPowerOfTwo
PREPROCESS_ON_GPU=1

# --- Audio chunking (window = Whisper-like long context; do not use vad on podcasts) ---
CHUNKING=window
MAX_CHUNK_S=30
CHUNK_OVERLAP_S=1.0
CHUNK_CONTEXT_S=0.5
CHUNK_LOOKBACK_S=2.0
MIN_CHUNK_S=0.5
MAX_UPLOAD_MB=512

# --- Concurrency & Threads ---
MAX_CONCURRENT=1
ORT_INTRA_THREADS=4
ORT_INTER_THREADS=2
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# --- Idle VRAM release (0 = never unload; like llama-server --sleep-idle-seconds) ---
SLEEP_IDLE_SECONDS=60
LOAD_AT_STARTUP=1
CUDA_DEVICE_RESET=1

# --- Server & Logging ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
UPLOAD_DIR=/tmp/stt
CORS_ENABLE=1
# Comma-separated origins. Use * only behind a trusted network.
CORS_ORIGINS=*
